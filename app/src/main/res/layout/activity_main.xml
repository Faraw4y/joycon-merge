<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Joy-Con Merge"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:padding="16dp"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextColor="@color/text_secondary"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabIndicatorColor="@color/text_primary"
        android:background="@color/surface">
        <com.google.android.material.tabs.TabItem android:text="Status"/>
        <com.google.android.material.tabs.TabItem android:text="Remap"/>
        <com.google.android.material.tabs.TabItem android:text="Calibrate"/>
        <com.google.android.material.tabs.TabItem android:text="Test"/>
    </com.google.android.material.tabs.TabLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- STATUS TAB -->
            <LinearLayout android:id="@+id/tab_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button android:id="@+id/btn_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Start"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#43A047"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout style="@style/Card" android:orientation="vertical">
                    <TextView android:text="Status" style="@style/CardTitle"/>
                    <TextView android:id="@+id/tv_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Not running"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout style="@style/Card" android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <TextView android:text="Detected devices" style="@style/CardTitle"/>
                    <TextView android:id="@+id/tv_devices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>

            <!-- REMAP TAB -->
            <LinearLayout android:id="@+id/tab_remap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/Card" android:orientation="vertical">
                    <TextView android:text="Right Joy-Con" style="@style/CardTitle"/>
                    <include layout="@layout/row_spinner" android:id="@+id/row_a"/>
                    <!-- We inline spinners directly -->
                    <TextView android:text="A button" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_a" style="@style/Spinner"/>
                    <TextView android:text="B button" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_b" style="@style/Spinner"/>
                    <TextView android:text="X button" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_x" style="@style/Spinner"/>
                    <TextView android:text="Y button" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_y" style="@style/Spinner"/>
                    <TextView android:text="R" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_r" style="@style/Spinner"/>
                    <TextView android:text="ZR" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_zr" style="@style/Spinner"/>
                    <TextView android:text="+ (Plus)" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_plus" style="@style/Spinner"/>
                    <TextView android:text="R3 (stick click)" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_r3" style="@style/Spinner"/>
                </LinearLayout>

                <LinearLayout style="@style/Card" android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <TextView android:text="Left Joy-Con" style="@style/CardTitle"/>
                    <TextView android:text="L" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_l" style="@style/Spinner"/>
                    <TextView android:text="ZL" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_zl" style="@style/Spinner"/>
                    <TextView android:text="- (Minus)" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_minus" style="@style/Spinner"/>
                    <TextView android:text="L3 (stick click)" style="@style/RowLabel"/>
                    <Spinner android:id="@+id/sp_l3" style="@style/Spinner"/>
                </LinearLayout>

                <Button android:id="@+id/btn_save_remap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save mapping"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/text_primary"
                    android:textColor="@color/bg"/>
            </LinearLayout>

            <!-- CALIBRATE TAB -->
            <LinearLayout android:id="@+id/tab_calib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/Card" android:orientation="vertical">
                    <TextView android:text="Deadzone (flat)" style="@style/CardTitle"/>
                    <TextView android:id="@+id/tv_flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>
                    <SeekBar android:id="@+id/sb_flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="16384"/>
                    <TextView android:text="Higher = more dead center. Raise if sticks drift."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout style="@style/Card" android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <TextView android:text="Noise filter (fuzz)" style="@style/CardTitle"/>
                    <TextView android:id="@+id/tv_fuzz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>
                    <SeekBar android:id="@+id/sb_fuzz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="2048"/>
                    <TextView android:text="Higher = smoother but less precise."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout style="@style/Card" android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <TextView android:text="Invert axes" style="@style/CardTitle"/>
                    <CheckBox android:id="@+id/cb_inv_lx" android:text="Invert left X"
                        android:textColor="@color/text_primary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <CheckBox android:id="@+id/cb_inv_ly" android:text="Invert left Y"
                        android:textColor="@color/text_primary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <CheckBox android:id="@+id/cb_inv_rx" android:text="Invert right X"
                        android:textColor="@color/text_primary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <CheckBox android:id="@+id/cb_inv_ry" android:text="Invert right Y"
                        android:textColor="@color/text_primary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>

                <Button android:id="@+id/btn_save_calib"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save calibration"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/text_primary"
                    android:textColor="@color/bg"/>
            </LinearLayout>

            <!-- TEST TAB -->
            <LinearLayout android:id="@+id/tab_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/Card" android:orientation="vertical">
                    <TextView android:text="Live event log" style="@style/CardTitle"/>
                    <TextView android:text="Start merge then press buttons to see events here."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tv_test_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
